<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Panderito.Core.ViewModels;assembly=Panderito.Core"
             x:Class="Panderito.App.Views.PrestamosPage"
             x:DataType="vm:PrestamosViewModel"
             Title="Préstamos"
             BackgroundColor="{AppThemeBinding Light={StaticResource Fondo}, Dark={StaticResource FondoDark}}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16" RowSpacing="12">

        <!-- Toggle Me deben / Debo -->
        <Border Grid.Row="0" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                BackgroundColor="{AppThemeBinding Light={StaticResource Superficie}, Dark={StaticResource SuperficieDark}}"
                Padding="4">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                <Button Grid.Column="0" Text="Me deben" FontAttributes="Bold" CornerRadius="12" HeightRequest="42"
                        Command="{Binding VerMeDebenCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IndiceTipo}" Value="0">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource IngresoSoft}, Dark={StaticResource IngresoSoftDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ingreso}, Dark={StaticResource IngresoDark}}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IndiceTipo}" Value="1">
                            <Setter Property="BackgroundColor" Value="Transparent" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoSuave}, Dark={StaticResource TextoSuaveDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1" Text="Debo" FontAttributes="Bold" CornerRadius="12" HeightRequest="42"
                        Command="{Binding VerDeboCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IndiceTipo}" Value="1">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource GastoSoft}, Dark={StaticResource GastoSoftDark}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gasto}, Dark={StaticResource GastoDark}}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Button" Binding="{Binding IndiceTipo}" Value="0">
                            <Setter Property="BackgroundColor" Value="Transparent" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoSuave}, Dark={StaticResource TextoSuaveDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
        </Border>

        <!-- Total pendiente -->
        <Border Grid.Row="1" Style="{StaticResource Tarjeta}">
            <HorizontalStackLayout Spacing="8">
                <Label Text="Total pendiente:" Style="{StaticResource TextoSecundario}" VerticalOptions="Center" />
                <Label Text="{Binding TotalTexto}" FontAttributes="Bold" FontSize="18"
                       TextColor="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoDark}}" />
            </HorizontalStackLayout>
        </Border>

        <!-- Lista -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="8">
                <Label Text="Sin préstamos en esta vista 🤝"
                       Style="{StaticResource EtiquetaVacio}"
                       IsVisible="{Binding HayPrestamos, Converter={StaticResource InvertedBoolConverter}}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Prestamos}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:PrestamoResumen">
                            <Border Style="{StaticResource Tarjeta}" Padding="14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding AbrirDetalleCommand, Source={RelativeSource AncestorType={x:Type vm:PrestamosViewModel}}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="{Binding Prestamo.Persona}" FontAttributes="Bold" FontSize="15"
                                               TextColor="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoDark}}" />
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding FechaTexto}" Style="{StaticResource TextoSecundario}" FontSize="12" />
                                            <Label Text="·" Style="{StaticResource TextoSecundario}" FontSize="12" />
                                            <Label Text="{Binding MontoTexto}" Style="{StaticResource TextoSecundario}" FontSize="12" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="End">
                                        <Label Text="{Binding PendienteTexto}" FontAttributes="Bold" FontSize="15" HorizontalTextAlignment="End"
                                               TextColor="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoDark}}" />
                                        <Border Style="{StaticResource Chip}" HorizontalOptions="End">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding EstadoTexto}" Value="Pagado">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource IngresoSoft}, Dark={StaticResource IngresoSoftDark}}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding EstadoTexto}" Value="Parcial">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource InfoSoft}, Dark={StaticResource InfoSoftDark}}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding EstadoTexto}" Value="Pendiente">
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PendienteSoft}, Dark={StaticResource PendienteSoftDark}}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="{Binding EstadoTexto}" FontSize="11" FontAttributes="Bold">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding EstadoTexto}" Value="Pagado">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ingreso}, Dark={StaticResource IngresoDark}}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding EstadoTexto}" Value="Parcial">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Info}, Dark={StaticResource InfoDark}}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding EstadoTexto}" Value="Pendiente">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Pendiente}, Dark={StaticResource PendienteDark}}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="3" Text="＋ Nuevo préstamo" Style="{StaticResource BotonPrimario}"
                Command="{Binding NuevoCommand}" />
    </Grid>
</ContentPage>
