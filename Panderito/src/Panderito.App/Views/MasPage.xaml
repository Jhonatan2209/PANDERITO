<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Panderito.Core.ViewModels;assembly=Panderito.Core"
             x:Class="Panderito.App.Views.MasPage"
             x:DataType="vm:MasViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Fondo}, Dark={StaticResource FondoDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="16,24,16,16" Spacing="10">
            <Label Text="Más" Style="{StaticResource TituloPantalla}" />
            <Label Text="Todos los módulos de Panderito" Style="{StaticResource TextoSecundario}" Margin="0,0,0,8" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Opciones}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:OpcionMenu">
                        <Border Style="{StaticResource Tarjeta}" Padding="14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding AbrirCommand, Source={RelativeSource AncestorType={x:Type vm:MasViewModel}}}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Label Grid.Column="0" Text="{Binding Icono}" FontSize="24" VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Nombre}" FontAttributes="Bold" FontSize="15"
                                           TextColor="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoDark}}" />
                                    <Label Text="{Binding Descripcion}" Style="{StaticResource TextoSecundario}" FontSize="12" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" FontSize="22" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextoTenue}, Dark={StaticResource TextoTenueDark}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
