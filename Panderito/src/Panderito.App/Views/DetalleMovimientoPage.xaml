<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Panderito.Core.ViewModels;assembly=Panderito.Core"
             x:Class="Panderito.App.Views.DetalleMovimientoPage"
             x:DataType="vm:DetalleMovimientoViewModel"
             Title="Detalle"
             BackgroundColor="{AppThemeBinding Light={StaticResource Fondo}, Dark={StaticResource FondoDark}}">

    <VerticalStackLayout Padding="16,20" Spacing="16">

        <Border Style="{StaticResource Tarjeta}" Padding="20">
            <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 18"
                        BackgroundColor="{Binding Detalle.ColorCategoria, Converter={StaticResource ColorHexConverter}}"
                        WidthRequest="64" HeightRequest="64" HorizontalOptions="Center">
                    <Label Text="{Binding Detalle.IconoCategoria}" FontSize="28"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Label Text="{Binding Detalle.MontoTexto}" FontSize="34" FontAttributes="Bold" HorizontalOptions="Center">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding Detalle.EsGasto}" Value="True">
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gasto}, Dark={StaticResource GastoDark}}" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding Detalle.EsGasto}" Value="False">
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ingreso}, Dark={StaticResource IngresoDark}}" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="Categoría" Style="{StaticResource TextoSecundario}" />
                        <Label Grid.Column="1" Text="{Binding Detalle.NombreCategoria}" FontAttributes="Bold" HorizontalTextAlignment="End"
                               TextColor="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoDark}}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="Cuenta" Style="{StaticResource TextoSecundario}" />
                        <Label Grid.Column="1" Text="{Binding Detalle.NombreCuenta}" FontAttributes="Bold" HorizontalTextAlignment="End"
                               TextColor="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoDark}}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="Fecha" Style="{StaticResource TextoSecundario}" />
                        <Label Grid.Column="1" Text="{Binding Detalle.FechaTexto}" FontAttributes="Bold" HorizontalTextAlignment="End"
                               TextColor="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoDark}}" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="Nota" Style="{StaticResource TextoSecundario}" />
                        <Label Grid.Column="1" Text="{Binding Detalle.Movimiento.Nota}" HorizontalTextAlignment="End"
                               TextColor="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoDark}}" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>

        <Button Text="🗑 Eliminar movimiento"
                Command="{Binding EliminarCommand}"
                BackgroundColor="{AppThemeBinding Light={StaticResource GastoSoft}, Dark={StaticResource GastoSoftDark}}"
                TextColor="{AppThemeBinding Light={StaticResource Gasto}, Dark={StaticResource GastoDark}}"
                FontAttributes="Bold"
                CornerRadius="16"
                HeightRequest="52" />

    </VerticalStackLayout>
</ContentPage>
