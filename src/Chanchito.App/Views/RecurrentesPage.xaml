<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Chanchito.Core.ViewModels;assembly=Chanchito.Core"
             x:Class="Chanchito.App.Views.RecurrentesPage"
             x:DataType="vm:RecurrentesViewModel"
             Title="Gastos recurrentes"
             BackgroundColor="{AppThemeBinding Light={StaticResource Fondo}, Dark={StaticResource FondoDark}}">

    <Grid RowDefinitions="*,Auto" Padding="16">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="8">
                <Label Text="Sin gastos recurrentes 🔁&#10;Agrega tus servicios (luz, agua, internet…)"
                       Style="{StaticResource EtiquetaVacio}"
                       IsVisible="{Binding HayRecurrentes, Converter={StaticResource InvertedBoolConverter}}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Recurrentes}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecurrenteItem">
                            <Border Style="{StaticResource Tarjeta}" Padding="14">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding EditarCommand, Source={RelativeSource AncestorType={x:Type vm:RecurrentesViewModel}}}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="{Binding Recurrente.Nombre}" FontAttributes="Bold" FontSize="15"
                                                   TextColor="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoDark}}" />
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding FrecuenciaTexto}" Style="{StaticResource TextoSecundario}" FontSize="12" />
                                                <Label Text="·" Style="{StaticResource TextoSecundario}" FontSize="12" />
                                                <Label Text="{Binding ProximaFechaTexto}" Style="{StaticResource TextoSecundario}" FontSize="12" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="End">
                                            <Label Text="{Binding MontoTexto}" FontAttributes="Bold" FontSize="15" HorizontalTextAlignment="End"
                                                   TextColor="{AppThemeBinding Light={StaticResource Texto}, Dark={StaticResource TextoDark}}" />
                                            <Label Text="{Binding VenceTexto}" FontSize="11" HorizontalTextAlignment="End">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding EstaVencido}" Value="True">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Pendiente}, Dark={StaticResource PendienteDark}}" />
                                                        <Setter Property="FontAttributes" Value="Bold" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding EstaVencido}" Value="False">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextoSuave}, Dark={StaticResource TextoSuaveDark}}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Button Text="✓ Registrar pago"
                                            Style="{StaticResource BotonSecundario}"
                                            HeightRequest="40" FontSize="13"
                                            Command="{Binding RegistrarPagoCommand, Source={RelativeSource AncestorType={x:Type vm:RecurrentesViewModel}}}"
                                            CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="1" Text="＋ Nuevo recurrente" Style="{StaticResource BotonPrimario}"
                Command="{Binding NuevoCommand}" Margin="0,12,0,0" />
    </Grid>
</ContentPage>
