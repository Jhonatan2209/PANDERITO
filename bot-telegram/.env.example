# Copia este archivo a ".env" y completa los valores (NO subas .env a git).

# Token del bot de Telegram (créalo con @BotFather en Telegram).
TELEGRAM_BOT_TOKEN=

# Clave del API de Claude para leer las imágenes con IA.
# ⚠️ El modo API genera costos. Consíguela en console.anthropic.com.
ANTHROPIC_API_KEY=

# (Opcional) IDs de Telegram autorizados a usar el bot, separados por coma.
# Si se deja vacío, cualquiera que tenga el bot puede usarlo.
TELEGRAM_ALLOWED_IDS=
